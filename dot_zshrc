# Give Pi one GitHub token for all child gh commands.
# Keep the interactive gh alias on the 1Password shell plugin.
function pi {
  local gh_token="${GH_TOKEN:-}"

  if [[ -z "$gh_token" ]]; then
    gh_token="$(op plugin run -- gh auth token)" || return
  fi

  GH_TOKEN="$gh_token" command pi --tui-mode fullscreen "$@"
}

