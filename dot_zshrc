# Replace the Oh My Zsh history alias with an interactive history selector.
unalias history 2>/dev/null
# With no arguments, select a previous command, edit it, then load it at the next prompt.
history() {
  if (( $# )); then
    builtin history "$@"
    return
  fi

  local selected command_file
  selected="$(fc -rl 1 | fzf --height 40% --reverse --tac --no-sort)" || return
  selected="$(sed -E 's/^[[:space:]]*[0-9]+[[:space:]]+//' <<< "$selected")"
  [[ -n "$selected" ]] || return

  command_file="$(mktemp "${TMPDIR:-/tmp}/history-command.XXXXXX")" || return
  print -r -- "$selected" > "$command_file"
  nvim "$command_file"
  selected="$(<"$command_file")"
  rm -f -- "$command_file"

  [[ -n "$selected" ]] && print -z -- "$selected"
}

