{
  "$schema": "./settings.schema.json",
  "version": 1,
  "autoApplyWorktrees": true,
  "onlyIfPristine": true,
  "defaultLayout": "agent-terminal",
  "layouts": {
    "agent-terminal": {
      "label": "Agent + terminal",
      "focus": "agent",
      "tabs": [
        {
          "id": "agent",
          "label": "agent",
          "existing": true,
          "panes": [
            {
              "id": "agent",
              "label": "agent",
              "existing": true,
              "command": "bash \"{{plugin_root}}/scripts/select-agent.sh\" pi claude"
            }
          ]
        },
        {
          "id": "terminal",
          "label": "terminal",
          "panes": [
            {
              "id": "terminal",
              "label": "terminal",
              "existing": true,
              "command": "node \"{{plugin_root}}/scripts/bootstrap.mjs\""
            }
          ]
        }
      ]
    },
    "agent-only": {
      "label": "Agent only",
      "focus": "agent",
      "tabs": [
        {
          "id": "agent",
          "label": "agent",
          "existing": true,
          "panes": [
            {
              "id": "agent",
              "label": "agent",
              "existing": true,
              "command": "bash \"{{plugin_root}}/scripts/select-agent.sh\" pi claude"
            }
          ]
        }
      ]
    },
    "terminal-only": {
      "label": "Terminal only",
      "focus": "terminal",
      "tabs": [
        {
          "id": "terminal",
          "label": "terminal",
          "existing": true,
          "panes": [
            {
              "id": "terminal",
              "label": "terminal",
              "existing": true
            }
          ]
        }
      ]
    }
  }
}
