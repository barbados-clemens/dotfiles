{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Herdr workspace layout settings",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "defaultLayout", "layouts"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "autoApplyWorktrees": {
      "type": "boolean",
      "default": true
    },
    "onlyIfPristine": {
      "type": "boolean",
      "default": true
    },
    "defaultLayout": {
      "type": "string",
      "minLength": 1
    },
    "layouts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/layout"
      }
    }
  },
  "$defs": {
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tabs"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "onlyIfPristine": {
          "type": "boolean"
        },
        "focus": {
          "type": "string"
        },
        "tabs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/tab"
          }
        }
      }
    },
    "tab": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "existing": {
          "type": "boolean",
          "default": false
        },
        "panes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/pane"
          }
        }
      }
    },
    "pane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "existing": {
          "type": "boolean",
          "default": false
        },
        "command": {
          "type": ["string", "null"]
        },
        "split": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "target": {
              "type": "string",
              "minLength": 1
            },
            "direction": {
              "enum": ["right", "down"],
              "default": "right"
            },
            "ratio": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1,
              "default": 0.5
            }
          }
        }
      }
    }
  }
}
